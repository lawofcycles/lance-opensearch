// Permissions the plugin's jars need beyond what OpenSearch grants every
// codebase. OpenSearch 3.x enforces java.io.FilePermission (on java.nio.file
// operations) and java.net.SocketPermission (on socket connects) through its
// Java agent, and the agent checks every protection domain on the stack up
// to the nearest AccessController.doPrivileged frame. The core policy already
// grants every codebase read, write and delete under path.data, path.logs,
// path.repo and java.io.tmpdir, so the Lance JNI extraction and the
// node_local clone directories need no grant here.
// The Lance native library reads and writes table files itself, outside the
// JVM, so the agent never sees those operations; the lance.allowed_table_roots
// setting is what limits which paths a table may be opened from.
//
// The RuntimePermission and ReflectPermission grants are not checked by the
// 3.x agent. They stay because `opensearch-plugin install` shows them to the
// operator and because they record what the bundled code does, the same way
// the repository-s3, k-NN and neural-search plugins declare theirs.
grant {
  // io.questdb.jar.jni.JarJniLoader (lance-core's JniLoader) and
  // org.apache.arrow.c.jni.JniLoader extract liblance_jni and
  // libarrow_cdata_jni to a temporary file and call System.load on it, whose
  // permission name is loadLibrary.<absolute path>; the path is random, so
  // the wildcard is required.
  permission java.lang.RuntimePermission "loadLibrary.*";

  // org.opensearch.lance.query.FtsAdmission reads MemAvailable from
  // /proc/meminfo to size full text scans; the core policy grants
  // /proc/self/status (which FtsAdmission also reads) to every codebase but
  // not /proc/meminfo. Read only, inside doPrivileged, so only the plugin's
  // own domain is consulted.
  permission java.io.FilePermission "/proc/meminfo", "read";

  // Reflection. TransportLanceFragmentQueryAction and TransportLanceStatsAction
  // call the package private IndexService.getReaderWrapper through
  // getDeclaredMethod plus setAccessible; CoreAggregationResults opens a
  // package private Lucene constructor the same way; Calcite's
  // JaninoRelMetadataProvider instantiates the metadata handler classes it
  // compiles through getDeclaredConstructors; Arrow's MemoryUtil and Guava's
  // AbstractFuture reach
  // sun.misc.Unsafe through reflection on their static initializers (the same
  // classes thirdPartyAudit lists under ignoreViolations).
  permission java.lang.RuntimePermission "accessDeclaredMembers";
  permission java.lang.reflect.ReflectPermission "suppressAccessChecks";
  permission java.lang.RuntimePermission "accessClassInPackage.sun.misc";

  // Calcite compiles its metadata handlers with Janino at first use;
  // Janino's compiler defines them in a class loader of its own.
  // CompilerFactoryFactory (commons-compiler), Jackson's ClassUtil and the
  // AWS SDK's ClassLoaderHelper read the context class loader when they
  // resolve classes and services by name.
  permission java.lang.RuntimePermission "createClassLoader";
  permission java.lang.RuntimePermission "getClassLoader";

  // Outbound connections from the Java clients the plugin bundles: the AWS
  // SDK Glue client (url-connection-client) and the Iceberg REST, Polaris and
  // Unity catalog clients (Apache HttpClient 5), plus the SDK's credential
  // lookups (instance metadata, STS). The Lance native library opens its own
  // object store connections outside the JVM. repository-s3 grants the same
  // wildcard for the AWS SDK.
  permission java.net.SocketPermission "*", "connect,resolve";
};
