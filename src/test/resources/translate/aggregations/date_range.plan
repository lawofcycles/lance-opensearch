LanceAggregate(group=[{0}], buckets=[[DATE_RANGE{name=dr, ranges=[(old, null, 1704067200000), (new, 1704067200000, null)]}]])
  LogicalProject(dr=[+(CASE(<(CAST(UNIX_MILLIS($7)):DOUBLE NOT NULL, 1.7040672E12), 1, 0), CASE(>=(CAST(UNIX_MILLIS($7)):DOUBLE NOT NULL, 1.7040672E12), 2, 0))], id=[$0], rating=[$1], price=[$2], weight=[$3], category=[$4], body=[$5], flag=[$6], ts=[$7], day=[$8])
    LanceTableScan(table=[[lance, idx]])
