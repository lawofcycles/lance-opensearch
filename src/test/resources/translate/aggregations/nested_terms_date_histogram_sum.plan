LanceAggregate(group=[{0, 1}], s=[SUM($4)], buckets=[[TERMS{name=by_cat, size=10, shardSize=25, minDocCount=1, order=COUNT_DESC}, DATE_HISTOGRAM_FIXED{name=by_hour, minDocCount=0, intervalMillis=3600000}]], metrics=[[SUM{name=s}]])
  LogicalProject(by_cat=[$4], by_hour=[FLOOR(/(UNIX_MILLIS($7), 3600000))], id=[$0], rating=[$1], price=[$2], weight=[$3], category=[$4], body=[$5], flag=[$6], ts=[$7], day=[$8])
    LanceTableScan(table=[[lance, idx]])
