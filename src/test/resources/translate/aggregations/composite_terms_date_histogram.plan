LanceAggregate(group=[{0, 1}], s=[SUM($4)], buckets=[[COMPOSITE_TERMS{name=cat, sourceOrder=ASC, compositeSize=10}, COMPOSITE_DATE_HISTOGRAM{name=d, intervalMillis=86400000, sourceOrder=ASC, compositeSize=10}]], metrics=[[SUM{name=s}]])
  LogicalProject(cat=[$4], d=[*(FLOOR(/(UNIX_MILLIS($7), 86400000)), 86400000)], id=[$0], rating=[$1], price=[$2], weight=[$3], category=[$4], body=[$5], flag=[$6], ts=[$7], day=[$8])
    LanceTableScan(table=[[lance, idx]])
