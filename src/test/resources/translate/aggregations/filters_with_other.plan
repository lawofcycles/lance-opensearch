LanceAggregate(group=[{0}], buckets=[[FILTERS{name=fs, keys=[high, low], otherBucketKey=rest}]], filters=[[[>=(CAST($2):BIGINT NOT NULL, 100), <(CAST($2):BIGINT NOT NULL, 100)]]])
  LogicalProject(fs=[+(CASE(>=(CAST($1):BIGINT NOT NULL, 100), 1, 0), CASE(<(CAST($1):BIGINT NOT NULL, 100), 2, 0))], id=[$0], rating=[$1], price=[$2], weight=[$3], category=[$4], body=[$5], flag=[$6], ts=[$7], day=[$8])
    LanceTableScan(table=[[lance, idx]])
